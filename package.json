{
  "name": "omni-mailer",
  "version": "1.1.0",
  "description": "Universal TypeScript email service supporting multiple providers with tracking, webhooks, and attachment handling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./webhooks": {
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.js",
      "types": "./dist/webhooks/index.d.ts"
    },
    "./webhooks/ses": {
      "import": "./dist/webhooks/ses.js",
      "require": "./dist/webhooks/ses.js",
      "types": "./dist/webhooks/ses.d.ts"
    },
    "./webhooks/mailgun": {
      "import": "./dist/webhooks/mailgun.js",
      "require": "./dist/webhooks/mailgun.js",
      "types": "./dist/webhooks/mailgun.d.ts"
    },
    "./webhooks/sendgrid": {
      "import": "./dist/webhooks/sendgrid.js",
      "require": "./dist/webhooks/sendgrid.js",
      "types": "./dist/webhooks/sendgrid.d.ts"
    },
    "./webhooks/mailchimp": {
      "import": "./dist/webhooks/mailchimp.js",
      "require": "./dist/webhooks/mailchimp.js",
      "types": "./dist/webhooks/mailchimp.d.ts"
    },
    "./webhooks/tracking": {
      "import": "./dist/webhooks/tracking.js",
      "require": "./dist/webhooks/tracking.js",
      "types": "./dist/webhooks/tracking.d.ts"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "email",
    "ses",
    "mailgun",
    "sendgrid",
    "mailchimp",
    "zoho",
    "typescript",
    "webhook",
    "tracking"
  ],
  "author": "@bhaskardey",
  "repository": {
    "type": "git",
    "url": "https://github.com/BhaskarDey772/omni-mailer.git"
  },
  "homepage": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.7.0",
    "express": "^4.21.0",
    "form-data": "^4.0.1",
    "mailgun.js": "^10.2.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
